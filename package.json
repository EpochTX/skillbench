{
  "name": "skillbench-ai",
  "version": "1.0.0",
  "description": "Lint, score, secure and benchmark AI Agent Skills and instruction files across Codex, Claude Code, Cursor, Gemini CLI and GitHub Copilot.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "skillbench": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_EN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "assets/logo.svg",
    "docs/demo.svg",
    "docs/API.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:fixtures": "tsx tests/corpus/generate-fixtures.ts",
    "benchmark:rules": "pnpm benchmark:fixtures && tsx src/cli.ts benchmark tests/corpus/rules.yml --ci --no-color",
    "test:dist": "pnpm benchmark:fixtures && tsx scripts/verify-built-cli.ts",
    "package:smoke": "tsx scripts/verify-packed-package.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm benchmark:rules && pnpm build && pnpm test:dist",
    "pack:check": "pnpm pack --dry-run --json",
    "release:check": "pnpm verify && pnpm run audit:prod && pnpm run package:smoke && pnpm pack:check",
    "prepublishOnly": "pnpm verify && pnpm run audit:prod",
    "prepack": "pnpm build && pnpm test:dist"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "agent-skills",
    "agent-instructions",
    "agents-md",
    "codex",
    "claude-code",
    "cursor",
    "gemini-cli",
    "github-copilot",
    "developer-tools",
    "cli",
    "security",
    "sarif",
    "benchmark",
    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpochTX/skillbench.git"
  },
  "bugs": {
    "url": "https://github.com/EpochTX/skillbench/issues"
  },
  "homepage": "https://github.com/EpochTX/skillbench#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
