{
  "name": "skillbench-ai",
  "version": "0.2.0",
  "description": "The open benchmark, linter and compatibility checker for AI Agent Skills.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "skillbench": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "agent-skills",
    "codex",
    "claude-code",
    "cursor",
    "gemini",
    "copilot",
    "developer-tools",
    "cli",
    "security",
    "benchmark",
    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpochTX/skillbench.git"
  },
  "bugs": {
    "url": "https://github.com/EpochTX/skillbench/issues"
  },
  "homepage": "https://github.com/EpochTX/skillbench#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
